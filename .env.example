# Public site URL (used for sitemap, robots, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://japanprotips.com

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# OpenAI (itinerary planner; server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Upstash Redis (shared itinerary links; server-side only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Places (itinerary stop verification; server-side only)
GOOGLE_MAPS_API_KEY=
